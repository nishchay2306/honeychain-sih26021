# Copy this file to .env and fill in your own values.
# NEVER commit your real .env file — it contains your private key.

# RPC endpoint for Polygon Amoy testnet.
# Get a free one from https://www.alchemy.com/ or https://www.infura.io/
AMOY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_API_KEY

# Private key of the wallet you'll deploy from (MetaMask: Account Details > Export Private Key).
# Use a TEST wallet only — never your main wallet, never one holding real funds.
PRIVATE_KEY=your_test_wallet_private_key_without_0x_prefix

# Optional: for verifying the contract source on Polygonscan after deployment.
# Get a free key from https://polygonscan.com/myapikey
POLYGONSCAN_API_KEY=your_polygonscan_api_key
