# Server
PORT=4000

# Base URL the QR codes will point to (the frontend's scan page)
SCAN_BASE_URL=http://localhost:5173/scan

# Leave these blank to run against the in-memory mock store (good for early
# frontend development). Fill them in once the contract is deployed (Task 1.2)
# to switch the backend to live on-chain data.
CONTRACT_ADDRESS=
AMOY_RPC_URL=

# Leave blank to use the in-memory mock IPFS (Task 2.3). Get a free JWT from
# https://app.pinata.cloud/developers/api-keys to switch to real IPFS uploads.
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs

# Auth (Task 2.6) — CHANGE THIS before any real/shared deployment.
# For local dev the default below is fine.
JWT_SECRET=dev-only-secret-CHANGE-ME-in-production

# SQLite file path (created automatically). Swap to Postgres later using
# docs/postgres_schema.sql as a migration guide.
DB_PATH=./honeychain.db
